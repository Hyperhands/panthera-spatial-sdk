{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON"}
    }
  ],
  "buildPresets": [{"name": "host", "configurePreset": "host"}],
  "testPresets": [
    {"name": "host", "configurePreset": "host", "output": {"outputOnFailure": true}}
  ],
  "workflowPresets": [
    {
      "name": "host",
      "steps": [
        {"type": "configure", "name": "host"},
        {"type": "build", "name": "host"},
        {"type": "test", "name": "host"}
      ]
    }
  ]
}
